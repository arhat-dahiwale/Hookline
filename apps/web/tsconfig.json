{
  "extends": "@hookline/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@hookline/server/trpc-router": ["../server/dist/trpc-router.d.ts"]
    }
  },
  "include": ["src", "next.config.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
