{
  "name": "@hookline/server",
  "version": "0.1.0",
  "private": true,
  "description": "Hookline NestJS server (ROLE=api | worker | all)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/seed.ts",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.config.int.ts",
    "test:cov": "vitest run --coverage && vitest run --config vitest.config.int.ts --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@fastify/static": "10.1.10",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@hookline/proto": "workspace:*",
    "@hookline/shared": "workspace:*",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/event-emitter": "12.0.2",
    "@nestjs/platform-fastify": "12.4.0",
    "@nestjs/platform-ws": "12.4.0",
    "@nestjs/websockets": "12.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@trpc/server": "11.25.2",
    "better-auth": "1.7.18",
    "bullmq": "6.7.2",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "5.34.1",
    "undici": "8.12.4",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hookline/config": "workspace:*",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "1.16.22",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "0.31.11",
    "light-my-request": "6.8.0",
    "testcontainers": "12.2.1",
    "unplugin-swc": "2.0.0"
  }
}
