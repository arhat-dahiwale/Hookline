{
  "name": "@hookline/server",
  "version": "0.1.0",
  "private": true,
  "description": "Hookline NestJS server (ROLE=api | worker | all)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
