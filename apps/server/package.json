{
  "name": "@hookline/server",
  "version": "0.1.0",
  "private": true,
  "description": "Hookline NestJS server (ROLE=api | worker | all)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.config.int.ts --passWithNoTests"
  },
  "dependencies": {
    "@hookline/shared": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hookline/config": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.1",
    "unplugin-swc": "2.0.0"
  }
}
