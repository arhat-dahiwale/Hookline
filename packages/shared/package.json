{
  "name": "@hookline/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, types, ID helpers and constants for Hookline",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ulidx": "2.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hookline/config": "workspace:*",
    "@types/node": "24.19.2"
  }
}
