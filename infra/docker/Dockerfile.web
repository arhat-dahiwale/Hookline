# Multi-stage build for the Hookline dashboard (Next.js).
# Build context is the repo root:
#   docker build -f infra/docker/Dockerfile.web -t hookline-web .

# --- base: workspace manifests + install --------------------------------------
FROM node:24-alpine AS base
ENV CI=1
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-workspace.yaml .npmrc pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY packages/proto/package.json packages/proto/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --ignore-scripts

# --- build: server types first (web typechecks against server dist), then web --
FROM base AS build
COPY packages/ packages/
COPY apps/ apps/
# Type-only dependency: the web tsconfig maps @hookline/server/trpc-router to
# ../server/dist — server must be built before `next build` typechecks.
RUN pnpm --filter @hookline/server... run build && pnpm --filter @hookline/web run build
RUN pnpm --filter @hookline/web deploy --prod /out

# --- runner -------------------------------------------------------------------
FROM node:24-alpine AS runner
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY --from=build /out/package.json ./package.json
COPY --from=build /out/node_modules ./node_modules
# pnpm deploy skips build outputs (gitignored), so .next comes from the repo.
COPY --from=build /repo/apps/web/.next ./.next
EXPOSE 3000
USER node
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
