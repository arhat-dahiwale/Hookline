# Multi-stage build for the Hookline server image (api | worker | all).
# Build context is the repo root:
#   docker build -f infra/docker/Dockerfile.server -t hookline-server .

# --- base: workspace manifests + prod install ---------------------------------
FROM node:24-alpine AS base
ENV CI=1
RUN corepack enable
WORKDIR /repo
COPY package.json pnpm-workspace.yaml .npmrc pnpm-lock.yaml ./
COPY packages/config/package.json packages/config/
COPY packages/shared/package.json packages/shared/
COPY packages/proto/package.json packages/proto/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --ignore-scripts

# --- build: compile shared + server -------------------------------------------
FROM base AS build
COPY packages/ packages/
COPY apps/ apps/
RUN pnpm --filter @hookline/server... run build
# Prune to production deps into a self-contained deployable dir.
# --ignore-scripts: the deployed tree only RUNS node dist (no esbuild etc.);
# deploy's re-install otherwise fails on pnpm's unapproved-build-scripts
# policy (msgpackr-extract falls back to pure JS — fine at runtime).
RUN pnpm --filter @hookline/server deploy --prod --ignore-scripts /out

# --- runner -------------------------------------------------------------------
FROM node:24-alpine AS runner
ENV NODE_ENV=production ROLE=all PORT=4000
WORKDIR /app
COPY --from=build /out/package.json ./package.json
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /repo/apps/server/dist ./dist
# SQL migrations for the one-shot migrate service (dist/migrate.js applies them).
COPY --from=build /repo/apps/server/drizzle ./drizzle
EXPOSE 4000
# Runs as the node user from the base image
USER node
CMD ["node", "dist/main.js"]
