# ============================================================
# Hookline: environment variables
# Copy to .env and fill in. NEVER commit .env or real secrets.
# All values are validated with Zod at startup (the app refuses
# to boot on invalid config).
# ============================================================

# --- Runtime ---------------------------------------------------
# api | worker | all  (all = local dev, uses in-process adapters)
ROLE=all
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Postgres --------------------------------------------------
POSTGRES_USER=hookline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hookline
# Host ports 15432/16379 avoid conflicts with native services on 5432/6379.
POSTGRES_PORT=15432
DATABASE_URL=postgresql://hookline:change-me@localhost:15432/hookline

# --- Redis -----------------------------------------------------
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379

# --- Auth (Better Auth) ----------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-generated-secret
# Public URL where the auth routes are served
BETTER_AUTH_URL=http://localhost:4000

# --- Encryption (endpoint secrets, AES-256-GCM) ----------------
# 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored endpoint secrets unrecoverable.
ENCRYPTION_KEY=replace-with-generated-key

# --- Internal gRPC (api -> worker) -----------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_GRPC_TOKEN=replace-with-generated-token
WORKER_GRPC_URL=localhost:50051
GRPC_PORT=50051

# --- Delivery engine -------------------------------------------
DELIVERY_CONCURRENCY=10
SHUTDOWN_TIMEOUT_MS=30000
# DEV ONLY: allow http:// and localhost/private endpoint URLs
# (disables SSRF protections). Must be false anywhere real.
ALLOW_INSECURE_ENDPOINTS=false

# --- Data retention --------------------------------------------
RETENTION_DAYS=30

# --- Observability ---------------------------------------------
OTEL_SERVICE_NAME=hookline
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_ADMIN_PASSWORD=change-me

# --- Web (Next.js) ---------------------------------------------
# NEXT_PUBLIC_* values are exposed to the browser. No secrets here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws