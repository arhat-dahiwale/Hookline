{
  "name": "hookline",
  "version": "0.1.0",
  "private": true,
  "description": "Reliable webhook delivery infrastructure",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @hookline/server db:generate",
    "db:migrate": "pnpm --filter @hookline/server db:migrate",
    "db:seed": "pnpm --filter @hookline/server db:seed",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "proto:gen": "pnpm --filter @hookline/proto proto:gen",
    "check:dashboards": "node scripts/check-dashboards.mjs",
    "test:cov": "pnpm --filter @hookline/server test:cov"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@hookline/config": "workspace:*",
    "@playwright/test": "1.56.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js,cjs}": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "msgpackr-extract",
      "@swc/core"
    ]
  }
}
